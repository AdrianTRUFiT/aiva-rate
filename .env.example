# ---------------------------------------------------------------------------
# Everything here is optional. With none of it set, the app runs end to end:
# payments use a local stand-in and daily messages are written to .data/outbox
# instead of being sent. Set these to move to real Stripe test mode and real
# email.
# ---------------------------------------------------------------------------

# Public origin. Used for checkout return URLs and the resume links in emails.
APP_URL="http://localhost:3000"

# API server port. Vite proxies /api here in development.
PORT="3001"

# Signs resume tokens. Generate with: openssl rand -hex 32
# If unset, a new one is generated per process and resume links break on restart.
SESSION_SECRET=""

# Where enrolments and the file outbox live.
DATA_DIR=".data"

# --- Payments -------------------------------------------------------------
# Set STRIPE_SECRET_KEY to use real Stripe Checkout (sk_test_... for test mode).
# While it is empty, the local stand-in is used and the dev checkout route is
# mounted; setting it removes that route entirely.
STRIPE_SECRET_KEY=""
# From `stripe listen` or the Dashboard webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=""
RESET_PRICE_CENTS="2900"
RESET_CURRENCY="usd"

# --- Email ----------------------------------------------------------------
# Without RESEND_API_KEY, messages are written to DATA_DIR/outbox as text files.
RESEND_API_KEY=""
MAIL_FROM="Performance Wellness <guide@example.invalid>"

# --- Unused by the app ----------------------------------------------------
# The session engine has no runtime model dependency. This is only read by
# tooling that generates content drafts.
GEMINI_API_KEY=""
